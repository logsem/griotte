; Mutation tests: the reverse map rejects a lowered file with one
; deliberate error in its Griotte code (test/mutate.ml).

(executable
 (name mutate)
 (modules mutate)
 (libraries cheriot2griotte_lib))

(rule
 (targets mutate.out)
 (deps
  (:c ../inputs/cmdc/main.s)
  (:t ../inputs/temporal_isolation/K.s)
  (:a ../inputs/lib/griotte_assert.s))
 (action
  (with-stdout-to
   %{targets}
   (run %{exe:mutate.exe} %{c} %{t} %{a}))))

(rule
 (alias cheriot2griotte-test)
 (action
  (diff reverse/mutate.expected mutate.out)))
