; The cheriot2griotte executable (see ../dune). Not built by a plain
; `dune build`. The modules are a library, so that the tests
; (../test/mutate.ml) can lower a file and mutate the result.

(library
 (name cheriot2griotte_lib)
 (wrapped false)
 (modules :standard \ cheriot2griotte)
 (libraries str))

(executable
 (name cheriot2griotte)
 (modules cheriot2griotte)
 (libraries cheriot2griotte_lib))

(ocamllex cheriot_lexer)

(menhir
 (modules cheriot_grammar))

(alias
 (name cheriot2griotte)
 (deps cheriot2griotte.exe))

(alias
 (name default))
