; Golden tests of cheriot2griotte, on the alias cheriot2griotte-test:
; `classify --dump` of each in-scope trusted compartment and library, the
; exports of the untrusted compartments of the in-scope examples, and the
; mnemonic census of the in-scope trusted files. After an intended change
; of the output: `dune build @cheriot2griotte-test` then `dune promote`.
; Not built by a plain `dune build`.

(alias
 (name default))

(rule
 (targets cmdc_main.out)
 (deps
  (:s ../inputs/cmdc/main.s)
  (:d ../inputs/cmdc/main.dump))
 (action
  (with-stdout-to
   %{targets}
   (run %{exe:../src/cheriot2griotte.exe} classify %{s} --dump %{d}))))

(rule
 (alias cheriot2griotte-test)
 (action
  (diff cmdc_main.expected cmdc_main.out)))

