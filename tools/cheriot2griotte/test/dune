; {1 Reverse-map validation (Reverse)}
;
; For each generated file: the same lowering as above (same --name,
; --label-prefix, --labels), then the Griotte code mapped back to CHERIoT
; instructions and compared with the .s. The tool exits 1 on a mismatch;
; the summary of what was checked is a golden file (reverse/*.expected).

(rule
 (targets reverse_cmdc.out)
 (deps
  (:s ../inputs/cmdc/main.s))
 (action
  (with-stdout-to
   %{targets}
   (run
    %{exe:../src/cheriot2griotte.exe}
    reverse-check
    %{s}
    --name
    cmdc_compiled_main
    --label-prefix
    cmdc
    --source
    tools/cheriot2griotte/inputs/cmdc/main.s))))

(rule
 (alias cheriot2griotte-test)
 (action
  (diff reverse/cmdc.expected reverse_cmdc.out)))

(rule
 (targets reverse_cmdc_shared.out)
 (deps
  (:s ../inputs/cmdc_shared/main.s))
 (action
  (with-stdout-to
   %{targets}
   (run
    %{exe:../src/cheriot2griotte.exe}
    reverse-check
    %{s}
    --name
    cmdc_shared_compiled_main
    --label-prefix
    cmdc
    --source
    tools/cheriot2griotte/inputs/cmdc_shared/main.s))))

(rule
 (alias cheriot2griotte-test)
 (action
  (diff reverse/cmdc_shared.expected reverse_cmdc_shared.out)))

